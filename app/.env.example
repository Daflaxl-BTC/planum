# Supabase-Projekt: Werte unter
#   https://supabase.com/dashboard/project/<project-ref>/settings/api
# Anon-Key ist designbedingt public (laeuft im Browser), darf aber NICHT
# das Prod-Projekt referenzieren. Lokale/Preview-Builds bekommen ein
# eigenes Supabase-Projekt; Prod-Werte werden ausschliesslich in
# Vercel Environment Variables gepflegt.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
